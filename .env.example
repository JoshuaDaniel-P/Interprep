# =============================================================================
# PrepPilot Environment Configuration
# =============================================================================

# OpenAI API Key (Server-Side ONLY - Never expose to client/frontend)
# Used by Next.js route handlers /api/interview/evaluate-and-next and /api/interview/final-evaluation
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Client Configuration (Optional - falls back to demo offline mode if omitted)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
