# ==============================================================================
# PrepPilot Environment Variables Configuration
# ==============================================================================
# NOTE: All keys below are 100% OPTIONAL.
# If you don't provide these keys, PrepPilot automatically runs in
# ZERO-CONFIG OFFLINE MODE:
#  - Local Auth works automatically (Sign in, Sign up, Quick Demo Access)
#  - Database operations persist to local browser storage
#  - Interview AI uses the built-in intelligent STAR scoring & adaptive question engine
# ==============================================================================

# --- Optional: Firebase Cloud Authentication & Firestore ---
# If you want to sync users and sessions across multiple devices with Firebase:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Optional: Cloud LLM API Keys ---
# If provided, PrepPilot uses live Gemini 1.5 Flash or GPT-4o-mini for questions and scoring.
# If omitted, PrepPilot uses the built-in heuristic AI persona engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Admin Configuration (Server-Side ONLY - comma-separated list of admin email addresses)
ADMIN_EMAILS=admin@preppilot.com
